(--text-muted);font-size: 12px;display: flex;justify-content: space-between;align-items: center}\n\n    @media (max-width: 960px) {\n      .hero-magazine {grid-template-columns: 1fr;gap: 24px}\n\n      .plan-row {grid-template-columns: 1fr;gap: 16px}\n\n      .plan-action-area {text-align: left}\n\n      .whitespace-grid {grid-template-columns: 1fr}\n\n      .guide-step-columns {grid-template-columns: 1fr}\n\n      .numbered-faq-list {grid-template-columns: 1fr}\n\n      footer {flex-direction: column;gap: 12px;align-items: flex-start}\n    }\n  </style><header class=\"top-strip-nav\">\n    <div class=\"top-strip-inner\">\n      <div class=\"nav-identity\">涡轮社区 规约与调度档案</div>\n      <ul class=\"nav-links\">\n        <li><a href=\"#principles\">分流架构</a></li>\n        <li><a href=\"#plans\">订阅规格</a></li>\n        <li><a href=\"#clients\">客户端指引</a></li>\n        <li><a href=\"#faq\">排障解答</a></li>\n      </ul>\n    </div>\n  </header>\n\n  <main>\n    <section class=\"hero-magazine\">\n      <div class=\"hero-col-main\">\n        <h1>涡轮社区网络接入调度与节点分流技术配置指南</h1>\n        <p class=\"hero-lead-text\">\n          本平台面向多端网络请求提供静态分配与基于策略的路由调度方案。通过拆解高负载出站协议与分流策略，确保多类数据管道在标准协议定义下保持隔离与有序交换。\n        </p>\n      </div>\n\n      <div class=\"hero-col-quote\">\n        <blockquote class=\"editorial-quote\">\n          “流量的价值取决于其能否在设定的边界内稳定交付，而非单纯依赖瞬时的突发吞吐。”\n        </blockquote>\n        <div class=\"editorial-meta\">系统架构备忘录 / 卷七</div>\n      </div>\n\n      <div class=\"hero-col-meta\">\n        <div class=\"meta-stat-block\">\n          <div class=\"meta-stat-label\">协议兼容类型</div>\n          <div class=\"meta-stat-value\">Shadowsocks / Clash / Surge</div>\n        </div>\n        <div class=\"meta-stat-block\">\n          <div class=\"meta-stat-label\">核心控制面</div>\n          <div class=\"meta-stat-value\">自动化订阅下发与动态心跳</div>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"principles\">\n      <div class=\"section-head\">\n        <h2>架构准则</h2>\n        <p>基于无状态设计与局部路由解耦的核心执行规则</p>\n      </div>\n\n      <div class=\"whitespace-grid\">\n        <article class=\"whitespace-card\">\n          <div class=\"card-header-tag\">01 / 分流策略</div>\n          <h3>按目的地分流</h3>\n          <p>所有客户端入站请求由本地规则解析，对非对等网段实行域名下沉匹配，减少跨区链路中不必要的数据反射与往返延迟。</p>\n        </article>\n\n        <article class=\"whitespace-card\">\n          <div class=\"card-header-tag\">02 / 会话配额</div>\n          <h3>并发连接管理</h3>\n          <p>系统为每个订阅分派确定的最大并发设备数量与周期总配额，避免因单一客户端连接泄漏影响同一节点池内其它节点承载。</p>\n        </article>\n\n        <article class=\"whitespace-card\">\n          <div class=\"card-header-tag\">03 / 传输容灾</div>\n          <h3>多接入点备份</h3>\n          <p>核心路由节点配置独立健康监测线程。当单一中继入口发生不可抗波动时，订阅解析引擎支持快速变更到备用出口。</p>\n        </article>\n      </div>\n    </section>\n\n    <section id=\"plans\" class=\"plans-container\">\n      <div class=\"section-head\">\n        <h2>服务规格与订阅计划</h2>\n        <p>按照每月配额、在线设备承载以及节点网络分级编排的标准配置方案</p>\n      </div>\n\n      <article class=\"plan-row\">\n        <div class=\"plan-title-area\">\n          <div class=\"plan-tag\">通用入口</div>\n          <h3>基础版</h3>\n        </div>\n        <div class=\"plan-pricing-area\">\n          <div class=\"plan-main-price\">¥15/月</div>\n          <div class=\"plan-sub-price\">按年付仅需 ¥150/年</div>\n        </div>\n        <ul class=\"plan-feature-list\">\n          <li>每月 100GB 极速流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n        </ul>\n        <div class=\"plan-action-area\">\n          <a href=\"#\" class=\"plan-btn dim\">选用计划</a>\n        </div>\n      </article>\n\n      <article class=\"plan-row featured\">\n        <div class=\"plan-title-area\">\n          <div class=\"plan-tag\">推荐配置</div>\n          <h3>旗舰版</h3>\n        </div>\n        <div class=\"plan-pricing-area\">\n          <div class=\"plan-main-price\">¥35/月</div>\n          <div class=\"plan-sub-price\">按年付仅需 ¥350/年</div>\n        </div>\n        <ul class=\"plan-feature-list\">\n          <li>每月 300GB 极速流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7x24 优先工单支持</li>\n        </ul>\n        <div class=\"plan-action-area\">\n          <a href=\"#\" class=\"plan-btn\">选用计划</a>\n        </div>\n      </article>\n\n      <article class=\"plan-row\">\n        <div class=\"plan-title-area\">\n          <div class=\"plan-tag\">高并发协作</div>\n          <h3>团队版</h3>\n        </div>\n        <div class=\"plan-pricing-area\">\n          <div class=\"plan-main-price\">¥85/月</div>\n          <div class=\"plan-sub-price\">按年付仅需 ¥850/年</div>\n        </div>\n        <ul class=\"plan-feature-list\">\n          <li>每月 1000GB 极速流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n        <div class=\"plan-action-area\">\n          <a href=\"#\" class=\"plan-btn dim\">选用计划</a>\n        </div>\n      </article>\n    </section>\n\n    <section id=\"clients\" class=\"setup-guide\">\n      <div class=\"section-head\">\n        <h2>客户端配置与订阅接入</h2>\n        <p>涡轮社区使用通用规则配置协议，未绑定专用二进制应用，请选用支持通用格式的第三方客户端</p>\n      </div>\n\n      <div class=\"guide-step-columns\">\n        <div class=\"guide-step-item\">\n          <h4>步骤 1：获取订阅链接</h4>\n          <p>在用户控制台选定有效订阅后，复制专用的分发 URL。请注意妥善保存该链接，不要在公共代码仓或公开对话中张贴以防配额盗刷。</p>\n        </div>\n        <div class=\"guide-step-item\">\n          <h4>步骤 2：导入解析规则</h4>\n          <p>在本地终端（包括桌面端与移动操作系统）安装支持对应核心的工具，新建远程订阅并将链接粘贴至对应字段，触发配置拉取与缓存。</p>\n        </div>\n        <div class=\"guide-step-item\">\n          <h4>步骤 3：验证连通状态</h4>\n          <p>选择推荐的策略组（如 Rule 或 Auto），进行接入点握手延迟测试。确认正常返回握手时间后启动系统级代理或路由规则接管。</p>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"faq\" class=\"faq-section\">\n      <div class=\"section-head\">\n        <h2>常见问题解答</h2>\n        <p>针对接入鉴权、配额周期与连接行为的标准释疑</p>\n      </div>\n\n      <ul class=\"numbered-faq-list\">\n        <li class=\"numbered-faq-item\">\n          <div class=\"faq-index\">01</div>\n          <div class=\"faq-content\">\n            <h3>订阅流量的重置周期是如何计算的？</h3>\n            <p>流量统计按照订单创建之日作为对账基准日，按自然周期自动循环归零。未使用的流量不进行递延累计，当周期耗尽后系统将自动停止路由直到下一个账单周期生效。</p>\n          </div>\n        </li>\n\n        <li class=\"numbered-faq-item\">\n          <div class=\"faq-index\">02</div>\n          <div class=\"faq-content\">\n            <h3>超过设备同时在线限制会导致什么后果？</h3>\n            <p>当系统检测到发起会话的物理设备数量超过订阅规格时，网关将拒绝对新发起的设备建立传输隧道，或将早期会话移出活跃池。建议在路由层统一汇聚以减少设备占用。</p>\n          </div>\n        </li>\n\n        <li class=\"numbered-faq-item\">\n          <div class=\"faq-index\">03</div>\n          <div class=\"faq-content\">\n            <h3>为什么个别节点在拉取测试时出现握手超时？</h3>\n            <p>部分节点可能正处于周期性数据同步或上游网络调控状态。客户端订阅会包含高可用节点列表，遇到超时情况请切换至同区域内的其他候选接入点或等待下一轮规则更新。</p>\n          </div>\n        </li>\n\n        <li class=\"numbered-faq-item\">\n          <div class=\"faq-index\">04</div>\n          <div class=\"faq-content\">\n            <h3>平台是否提供预编译的专有客户端程序？</h3>\n            <p>涡轮社区遵循通用规范，不发行闭源客户端。用户需借助行业内成熟且公开审查的客户端软件，通过标准订阅协议拉取节点信息并维持连接。</p>\n          </div>\n        </li>\n      </ul>\n    </section>\n\n    <footer>\n      <div>© 涡轮社区 技术文档与网络服务说明. 保留所有权利.</div>\n      <div>标准传输协议适配 / 静态配置索引</div>\n    </footer>\n  </main>",
